    {
      "id": "perfil-cmd",
      "from": "usuario",
      "to": "telegram",
      "y": 448,
      "label": "/perfil",
      "variant": "emphasis",
      "note": "Solo active o paused: pending, rejected y blocked se atienden como /start"
    },
    {
      "id": "webhook-perfil",
      "from": "telegram",
      "to": "api",
      "y": 464,
