    {
      "id": "send-ask",
      "from": "api",
      "to": "telegram",
      "y": 496,
      "label": "sendMessage ASK_PROFILE",
      "variant": "dashed"
    },
    {
      "id": "deliver-ask",
      "from": "telegram",
      "to": "usuario",
      "y": 496,
      "label": "📄 Mandame tu perfil… .md / .txt",
      "variant": "emphasis"
    },
    {
      "id": "upload",
      "from": "usuario",
      "to": "telegram",
      "y": 524,
      "label": "perfil.md como documento",
      "variant": "emphasis",
      "note": "7.922 caracteres (8.058 bytes): no entra en un mensaje (tope 4096)"
    },
    {
      "id": "webhook-document",
      "from": "telegram",
      "to": "api",
      "y": 540,
      "label": "POST /telegram/webhook · document",
      "variant": "security",
      "note": "solo con state = awaiting_profile; Telegram manda el secreto en X-Telegram-Bot-Api-Secret-Token (si no coincide: 403); el endpoint contesta 200 {\"ok\": true}"
    },
    {
      "id": "get-file",
      "from": "api",
      "to": "telegram",
      "y": 568,
      "label": "getFile + GET → texto del .md",
      "variant": "dashed",
      "note": "download_file(file_id): getFile y Driver.get a FILE_URL; si no es .md / .txt, ASK_PROFILE otra vez"
    },
    {
      "id": "save-profile",
      "from": "api",
      "to": "db",
      "y": 584,
      "label": "set_profile + set_state('')",
      "variant": "default",
      "note": "reemplaza al perfil anterior"
